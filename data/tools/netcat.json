    "verifiedAt": "2026-10-17",
    "host": "darwin-arm64"
  },
  "modes": [
    {
      "id": "default",
      "name": "default",
      "summary": "Connect to a host and port, or -l to listen.",
      "usage": "nc [options] hostname port",
      "flags": [
        "close",
        "dont-resolve",
        "exec",
        "gateway",
        "hexdump",
        "interval",
        "listen",
        "local-port",
        "output",
        "pointer",
        "randomize",
        "source",
        "tcp",
        "telnet",
        "tunnel",
        "udp",
        "verbose",
        "version",
        "wait",
        "zero"
      ]
    }
  ],
  "inputs": [
    {
      "id": "host",
      "label": "Host",
      "kind": "host",
      "placeholder": "10.10.10.10",
      "help": "The host to connect to (omit for listen mode). Trailing. Withheld during verification.",
      "trailing": true,
      "example": "10.10.10.10"
    },
    {
      "id": "port",
      "label": "Port",
      "kind": "port",
      "placeholder": "4444",
      "help": "The port, after the host. Trailing.",
      "trailing": true,
      "example": "4444"
    }
  ],
