{
  "id": "netcat",
  "name": "nc",
  "summary": "The network Swiss army knife: connect, listen, scan ports, move data over TCP or UDP.",
  "category": "network",
  "homepage": "https://netcat.sourceforge.net/",
  "manual": "data/manuals/netcat.txt",
  "helpCommand": "nc -h",
